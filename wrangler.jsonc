{
  // Cloudflare Worker serving the landing page (static assets) plus the
  // waitlist API. Deploy: `npx wrangler deploy`
  "name": "tamage-v1",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "WAITLIST",
      "id": "67ce66e16dd7410e8db6f080c0d045cd"
    }
  ]
}
